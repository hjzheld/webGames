    "react-dom": "^19.0.0",
    "sass": "^1.89.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "overrides": {
